# Server Environment Configuration
# Copy to .env and fill in your values

# App
STAGE='EARLY'
PORT=5000
ENV='LOCAL'
HOST='http://localhost'

# Database driver: 'postgres' | 'memory'
# Use 'memory' for development/testing (data lost on restart)
# Use 'postgres' for persistent storage
DB_DRIVER=postgres

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:concept123@localhost:5432/conceptio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conceptio
DB_USER=postgres
DB_PASSWORD=concept123

# Diffusion Service
DIFFUSION_SERVICE_URL=http://localhost:8000
